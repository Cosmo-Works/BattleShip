+    private void updateAttackSpeedModifier() {
+        final AttributeInstance attackSpeed = this.getAttribute(Attributes.ATTACK_SPEED);
+        if (attackSpeed != null) {
+            attackSpeed.removeModifier(LEGACY_ATTACK_SPEED_MODIFIER);
+            if (this.level().shrekConfig().players.combat.legacyCombatMechanics) {
+                attackSpeed.addTransientModifier(LEGACY_ATTACK_SPEED_MODIFIER);
+            }
+        }
+    }
