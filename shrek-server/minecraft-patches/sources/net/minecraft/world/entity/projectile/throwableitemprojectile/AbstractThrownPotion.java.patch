--- a/net/minecraft/world/entity/projectile/throwableitemprojectile/AbstractThrownPotion.java
+++ b/net/minecraft/world/entity/projectile/throwableitemprojectile/AbstractThrownPotion.java
@@ -28,6 +_,28 @@ public abstract class AbstractThrownPotion extends ThrowableItemProjectile {
     protected static final double SPLASH_RANGE_SQ = 16.0;
     public static final Predicate<LivingEntity> WATER_SENSITIVE_OR_ON_FIRE = livingEntity -> livingEntity.isSensitiveToWater() || livingEntity.isOnFire();
 
+    @Override
+    public void shoot(
+        final double x,
+        final double y,
+        final double z,
+        final float speed,
+        final float divergence
+    ) {
+        super.shoot(x, y, z, speed, divergence);
+
+        final net.minecraft.world.phys.Vec3 movement = this.getDeltaMovement();
+        final double moveX = movement.x * this.level().shrekConfig().entities.thrownPotion.horizontalSpeed;
+        final double moveY = movement.y * this.level().shrekConfig().entities.thrownPotion.verticalSpeed;
+        final double moveZ = movement.z * this.level().shrekConfig().entities.thrownPotion.horizontalSpeed;
+        this.setDeltaMovement(moveX, moveY, moveZ);
+    }
+
+    @Override
+    protected final boolean breakInsideOwner() {
+        return this.level().shrekConfig().entities.thrownPotion.allowBreakingInsideEntities && this.tickCount >= 5;
+    }
+
     public AbstractThrownPotion(final EntityType<? extends AbstractThrownPotion> type, final Level level) {
