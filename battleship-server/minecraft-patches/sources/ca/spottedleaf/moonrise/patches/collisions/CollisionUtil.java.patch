+    private static void addMovementLoadTicket(
+        final ChunkAccess chunk,
+        final ChunkSource chunkSource,
+        final int chunkX,
+        final int chunkZ,
+        final long gameTime
+    ) {
+        if (!chunk.refreshMovementTicket(gameTime)) {
+            return;
+        }
+        if (!(chunkSource instanceof ServerChunkCache chunkCache)) {
+            return;
+        }
+        chunkCache.addTicketAtLevel(
+            TicketType.ENTITY_MOVEMENT,
+            new ChunkPos(chunkX, chunkZ),
+            ChunkLevel.ENTITY_TICKING_LEVEL
+        );
+    }
+
+    private static boolean shouldReadChunkOnThisThread(
+        final Level world,
+        final Entity entity,
+        final int chunkX,
+        final int chunkZ,
+        final boolean neighborhoodOwned
+    ) {
+        if (neighborhoodOwned) {
+            return true;
+        }
+        return entity != null
+            && entity.canCrossRegions()
+            && ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(world, chunkX, chunkZ);
+    }
