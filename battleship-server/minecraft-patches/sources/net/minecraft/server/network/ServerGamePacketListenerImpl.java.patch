+        this.awaitingTeleportTime = this.tickCount;
+        final float targetYRot = Mth.wrapDegrees(packet.getYRot(this.player.getYRot()));
+        final float targetXRot = Mth.wrapDegrees(packet.getXRot(this.player.getXRot()));
+        final double targetX = clampHorizontal(this.player.getX());
+        final double targetY = clampVertical(this.player.getY());
+        final double targetZ = clampHorizontal(this.player.getZ());
+        double movedDist = Mth.square(targetX - this.firstGoodX) + Mth.square(targetY - this.firstGoodY) + Mth.square(targetZ - this.firstGoodZ);
+        movedDist = Math.max(movedDist, Mth.square(targetX - this.player.getX()) + Mth.square(targetY - this.player.getY()) + Mth.square(targetZ - this.player.getZ()) - 1);
+        movedDist = Math.max(movedDist, Mth.square(targetX - this.lastGoodX) + Mth.square(targetY - this.lastGoodY) + Mth.square(targetZ - this.lastGoodZ) - 1);
+        this.receivedMovePacketCount++;
+        final int currTick = (int) (Util.getMillis() / 50);
+        this.allowedPlayerTicks += currTick - this.lastTick;
+        this.allowedPlayerTicks = Math.max(this.allowedPlayerTicks, 1);
+        this.lastTick = currTick;
+        if (this.player.getYRot() != targetYRot | this.player.getXRot() != targetXRot | movedDist > 0) {
+            this.allowedPlayerTicks -= 1;
+        } else {
+            this.allowedPlayerTicks = 20;
+        }
+        return true;
+    }
